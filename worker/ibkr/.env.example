# IBKR PAPER trading login (username starts differently from your live one). Never use the live login here.
TWS_USERID=
TWS_PASSWORD=

# Supabase project (same values as apps/web/.env)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Must match the INGEST_SECRET secret in Supabase → Edge Functions → Secrets.
# Generate with:  openssl rand -hex 32
INGEST_SECRET=

# --- Running on your Mac instead of Docker (run-local.sh) ---
# TWS logged in to the PAPER account: 7497. IB Gateway (paper): 4002.
# IB_HOST=127.0.0.1
# IB_PORT=7497
